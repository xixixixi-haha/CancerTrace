    highlightPadding: {x: 14, y: 12, z: 14, w: 12}
  - id: initial_clues
    target: {fileID: 749790738}
    interactionRegion: {fileID: 0}
    text: "\u6BCF\u4E2A\u75C5\u4F8B\u4F1A\u5148\u63D0\u4F9B\u4E24\u6761\u514D\u8D39\u7684\u57FA\u56E0\u7EBF\u7D22\u3002\nHIGH
      / LOW \u8868\u793A\u5BF9\u5E94\u57FA\u56E0\u7684\u8868\u8FBE\u72B6\u6001\u3002"
    stepType: 0
    dialogPosition: {x: -370.44507, y: -277.8995}
    dialogSize: {x: 0, y: 0}
    arrowPosition: {x: 0, y: -150}
    arrowRotation: 130
    arrowSize: {x: 190, y: 190}
    arrowScale: {x: 1, y: 1}
    highlightPadding: {x: 16, y: 16, z: 29.4368, w: 80.72278}
  - id: gene_scan
    target: {fileID: 866796198}
    interactionRegion: {fileID: 0}
    text: "\u70B9\u51FB\u201C\u626B\u63CF\u201D\u53EF\u4EE5\u83B7\u5F97 3 \u6761\u989D\u5916\u7684\u57FA\u56E0\u7EBF\u7D22\u3002\n\u6B63\u5F0F\u8C03\u67E5\u4E2D\uFF0C\u626B\u63CF\u9700\u8981\u6D88\u8017
      10 RP\u3002\n\u8BF7\u70B9\u51FB\u5DE6\u4FA7\u9AD8\u4EAE\u7684\u201C\u626B\u63CF\u201D\u6309\u94AE\u7EE7\u7EED\u3002"
    stepType: 1
    dialogPosition: {x: -121, y: -18}
