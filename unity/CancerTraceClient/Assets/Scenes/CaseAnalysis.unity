    arrowScale: {x: 1.0412, y: 0.94280666}
    highlightPadding: {x: 28.68711, y: 12, z: 29.55099, w: 26.30066}
  - id: cancer_galaxy
    target: {fileID: 1266571583}
    interactionRegion: {fileID: 0}
    text: "\u764C\u75C7\u661F\u56FE\u53EF\u4EE5\u67E5\u770B\u5F53\u524D\u75C5\u4F8B\u9644\u8FD1\u7684\u53C2\u8003\u6837\u672C\u3002\n\u6B63\u5F0F\u8C03\u67E5\u4E2D\uFF0C\u89C2\u5BDF\u661F\u56FE\u9700\u8981\u6D88\u8017
