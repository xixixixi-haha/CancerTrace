    arrowScale: {x: 1, y: 1}
    highlightPadding: {x: 12, y: 12, z: 12, w: 12}
  - id: gene_scan_evidence
    target: {fileID: 2089362291}
    interactionRegion: {fileID: 0}
    text: "\u65B0\u83B7\u5F97\u7684\u57FA\u56E0\u7EBF\u7D22\u4F1A\u6574\u7406\u5230\u8BC1\u636E\u677F\u4E2D\uFF0C\n\u53EF\u4EE5\u548C\u521D\u59CB\u7EBF\u7D22\u4E00\u8D77\u5224\u65AD\u3002"
