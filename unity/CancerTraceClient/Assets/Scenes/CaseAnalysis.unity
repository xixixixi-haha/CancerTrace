  - id: rp
    target: {fileID: 101691575}
    interactionRegion: {fileID: 0}
    text: "\u8C03\u67E5\u70B9\u662F\u6B63\u5F0F\u8C03\u67E5\u4E2D\u7684\u5171\u4EAB\u8D44\u6E90\u3002\n\u6BCF\u8F6E\u8C03\u67E5\u521D\u59CB\u62E5\u6709
      200 RP\u3002"
    stepType: 0
    dialogPosition: {x: 250, y: 100}
