    highlightPadding: {x: 12, y: 12, z: 12, w: 12}
  - id: ai_assistant
    target: {fileID: 995805618}
    interactionRegion: {fileID: 0}
    text: "AI\u8F85\u52A9\u4F1A\u63D0\u4F9B\u9884\u6D4B\u7ED3\u679C\u3001\u7F6E\u4FE1\u5EA6\u548C\u524D\u4E09\u5019\u9009\u3002\n\u6B63\u5F0F\u8C03\u67E5\u4E2D\uFF0CAI\u8F85\u52A9\u9700\u8981\u6D88\u8017
